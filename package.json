{
  "name": "@dsh-external/dsh-model-provider-headers",
  "version": "0.1.0",
  "description": "为 DSH 的 pi-ai 模型供应商提供请求头能力：设置页可视化编辑静态请求头，并把每段对话的稳定会话 ID 作为 x-opencode-session 请求头动态注入出站请求（供网关路由与提示词缓存优化）。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@earendil-works/pi-ai": "*",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.2.0",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:host": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}